# ==============================================================================
# ⚙️ GLOBAL GCP CONFIGURATION
# ==============================================================================
# Le reste de la config GCP (région, zone, noms de ressources) est dans
# make/config.mk.
# Example: GCP_PROJECT=mon-projet-gcp-id
GCP_PROJECT=

# Path to your GCP Service Account JSON key (mandatory for local/tests)
# Example: GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your/gcp-key.json
# GOOGLE_APPLICATION_CREDENTIALS=

# ==============================================================================
# 🗄️ STORAGE
# ==============================================================================
# Les noms de bucket GCS sont uniques GLOBALEMENT sur toute la plateforme GCP
# (pas juste dans ton projet) — le nom complet est reconstruit à partir de
# GCP_PROJECT + "berlue" (fixe) + ce suffixe.
# Un bucket supprimé ne se libère pas toujours proprement côté GCP (le nom peut
# rester "pris" un moment) — augmente ce suffixe (2, 3...) pour en recréer un.
# Nom final : ${GCP_PROJECT}-berlue_${BUCKET_SUFFIX}
BUCKET_SUFFIX=1

# ==============================================================================
# 🌍 QUEL ENVIRONNEMENT ?
# ==============================================================================
# Contre quel environnement tester avec `make test_api` : local | docker | gcp
# (github : pas encore configuré, prévu dans une tâche dédiée).
# L'URL est fixe pour local/docker, résolue automatiquement via `gcloud` pour gcp
# (cf. make/tests.mk, make cloudrun_url).
# Example: TEST_ENV=local
TEST_ENV=

# Où lancer l'API avec `make run_api` : local | docker | gcp (github : idem,
# pas encore configuré). Pilote aussi MLFLOW_TRACKING_URI (cf. berlue/params.py).
# Example: RUN_ENV=local
RUN_ENV=

# ==============================================================================
# 📊 DATA
# ==============================================================================
# Example: DATA_SIZE=1k
DATA_SIZE=

# ==============================================================================
# 🔔 NOTIFICATIONS (WEBHOOK)
# ==============================================================================
# Secret — ne jamais committer une vraie valeur ici.
# Example: NOTIFY_BASE_URL=https://hooks.slack.com/services/...
NOTIFY_BASE_URL=
