# 1. Récupère l'image de base dynamiquement (passée par le Makefile)
ARG DOCKER_BASE_IMAGE=python:3.10.6-slim
FROM ${DOCKER_BASE_IMAGE}

WORKDIR /eval

# 2. Installe les dépendances (production uniquement !)
COPY requirements.txt requirements.txt
RUN pip install --upgrade pip
RUN pip install --no-cache-dir -r requirements.txt

# 3. Copie le code source et installe le package
COPY berlue berlue
COPY setup.py setup.py
RUN pip install . && rm -rf build *.egg-info

# 4. Entraîne la baseline NLI pendant le build — le .joblib est gitignored,
# jamais présent dans un checkout propre ; entraîné ici plutôt que copié
# depuis le host, pour ne pas dépendre d'un `make train_baseline` préalable
# sur la machine qui build. Étapes 2-4 dupliquées à l'identique de
# `Dockerfile.eval` (choix de Xavier : image et intention distinctes du Job
# — celle-ci tourne en continu comme service, pas comme batch jetable — même
# raisonnement que la séparation `Dockerfile`/`Dockerfile.eval`).
RUN python -m berlue.nli_baseline.train

# 5. Sortie non bufferisée — cf. Dockerfile.eval pour le détail (marqueurs
# horodatés de `berlue.evaluation.timing` sinon bufferisés jusqu'à l'exit).
ENV PYTHONUNBUFFERED=1

# 6. Sert `berlue.api.eval_service` en continu (contrairement au Job,
# jetable, ce service est pensé pour tourner avec `min-instances=1` entre
# plusieurs appels — cf. `make gcp_up`/`gcp_down`). Même forme que le `CMD`
# du `Dockerfile` de l'API prod (`exec` pour la gestion des signaux).
CMD ["sh", "-c", "exec uvicorn berlue.api.eval_service:app --host 0.0.0.0 --port $PORT"]
